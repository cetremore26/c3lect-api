# Plantilla del entorno LOCAL de pruebas. Copiar a .env.development.local (ignorado por git).
# Base desechable en Docker; ninguna credencial real. Ver "Entorno de desarrollo aislado" en el README.
DATABASE_URL="postgresql://c3lect:c3lect@localhost:5433/c3lect_dev"
NODE_ENV="development"
PORT=3000
JWT_SECRET="dev-only-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"
# Clave falsa: Resend rechaza los envíos y solo quedan en el log (no sale ningún correo).
RESEND_API_KEY="re_dev_dummy"
RESEND_FROM="C3LECT Dev <dev@example.com>"
ADMIN_EMAIL="admin-dev@example.com"
# Reemplazar por el Access Token de PRUEBA de MercadoPago (empieza por TEST-) para probar pagos.
MP_ACCESS_TOKEN="TEST-reemplazar"
MP_WEBHOOK_SECRET="dev-webhook-secret"
# Vacíos: Conversions API queda deshabilitada (no se envía nada a Meta).
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_CAPI_TEST_EVENT_CODE=""
